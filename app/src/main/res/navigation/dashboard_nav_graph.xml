<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_nav_graph"
    app:startDestination="@id/loginGraph">

<!--    Authentication_Subgraph-->
    <navigation
        android:id="@+id/loginGraph"
        app:startDestination="@id/loginScreenFragment"
        >

        <fragment
            android:id="@+id/loginScreenFragment"
            android:name="com.example.sunnzaraa.ui.login.LoginScreenFragment"
            android:label="Login"
            tools:layout="@layout/fragment_login_screen">
            <action
                android:id="@+id/action_loginScreenFragment_to_registrationScreenFragment"
                app:destination="@+id/registrationScreenFragment"
                />

            <action
                android:id="@+id/action_loginScreenFragmment_to_homeGraph"
                app:destination="@+id/homeGraph"
                app:popUpTo="@id/loginGraph"
                app:popUpToInclusive="true"
                />
        </fragment>

        <fragment
            android:id="@+id/registrationScreenFragment"
            android:name="com.example.sunnzaraa.ui.registration.RegistrationScreenFragment"
            android:label="Registration"
            tools:layout="@layout/fragment_registration_screen">
            <action
                android:id="@+id/action_registrationScreenFragment_to_createPasswordScreenFragment"
                app:destination="@+id/createPasswordScreenFragment"
                />
            <action
                android:id="@+id/action_registrationScreenFragment_to_loginScreenFragment"
                app:destination="@+id/loginScreenFragment"
                />
        </fragment>

        <fragment
            android:id="@+id/createPasswordScreenFragment"
            android:name="com.example.sunnzaraa.ui.registration.CreatePasswordScreenFragment"
            android:label="CreatePassword"
            tools:layout="@layout/fragment_create_password_screen">
            <action
                android:id="@+id/action_createPasswordScreenFragment_to_personalDetailsScreenFragment"
                app:destination="@+id/personalDetailsScreenFragment"
                />
        </fragment>

        <fragment
            android:id="@+id/personalDetailsScreenFragment"
            android:name="com.example.sunnzaraa.ui.registration.PersonalDetailsScreenFragment"
            android:label="PersonalDetails"
            tools:layout="@layout/fragment_personal_details_screen">
            <action
                android:id="@+id/action_personalDetailsScreenFragment_to_termsConditionsScreenFragment"
                app:destination="@+id/termsConditionsScreenFragment"
                />
        </fragment>

        <fragment
            android:id="@+id/termsConditionsScreenFragment"
            android:name="com.example.sunnzaraa.ui.registration.TermsConditionsScreenFragment"
            android:label="TermsConditions"
            tools:layout="@layout/fragment_terms_conditions_screen">
            <action
                android:id="@+id/action_termsConditionsScreenFragment_to_homeGraph"
                app:destination="@+id/homeGraph"
                />
        </fragment>

    </navigation>


<!--    Home_Subgraph-->

    <navigation
        android:id="@+id/homeGraph"
        app:startDestination="@id/homeScreenFragment"
        >

        <fragment
            android:id="@+id/homeScreenFragment"
            android:name="com.example.sunnzaraa.ui.bottomBar.HomeScreenFragment"
            android:label="fragment_home_screen"
            tools:layout="@layout/fragment_home_screen" >
            <action
                android:id="@+id/action_homeScreenFragment_to_profileScreenFragment"
                app:destination="@+id/profileScreenFragment"
                />

            <action
                android:id="@+id/action_homeScreenFragment_to_favouritesScreenFragment"
                app:destination="@+id/favouritesScreenFragment"
                />

            <action
                android:id="@+id/action_homeScreenFragment_to_podcastScreenFragment"
                app:destination="@+id/podcastScreenFragment"
                />

        </fragment>

        <fragment
            android:id="@+id/profileScreenFragment"
            android:name="com.example.sunnzaraa.ui.profile.ProfileScreenFragment"
            android:label="fragment_profile_screen"
            tools:layout="@layout/fragment_profile_screen">
            <action
                android:id="@+id/action_profileScreenFragment_to_libraryScreenFragment"
                app:destination="@+id/libraryScreenFragment"
                />
            <action
                android:id="@+id/action_profileScreenFragment_to_favouritesScreenFragment"
                app:destination="@+id/favouritesScreenFragment"
                />
            <action
                android:id="@+id/action_profileScreenFragment_to_editProfileScreenFragment"
                app:destination="@+id/editProfileScreenFragment"
                />
        </fragment>

        <fragment
            android:id="@+id/libraryScreenFragment"
            android:name="com.example.sunnzaraa.ui.bottomBar.LibraryScreenFragment"
            android:label="fragment_library_screen"
            tools:layout="@layout/fragment_library_screen">
            <action
                android:id="@+id/action_libraryScreenFragment_to_favouritesScreenFragment"
                app:destination="@+id/favouritesScreenFragment"
                />
        </fragment>

        <fragment
            android:id="@+id/searchScreenFragment"
            android:name="com.example.sunnzaraa.ui.bottomBar.SearchScreenFragment"
            android:label="fragment_search_screen"
            tools:layout="@layout/fragment_search_screen">
        </fragment>

        <fragment
            android:id="@+id/premiumScreenFragment"
            android:name="com.example.sunnzaraa.ui.bottomBar.PremiumScreenFragment"
            android:label="fragment_premium_screen"
            tools:layout="@layout/fragment_premium_screen">
        </fragment>

        <fragment
            android:id="@+id/musicLanguagesScreenFragment"
            android:name="com.example.sunnzaraa.ui.drawer.MusicLanguagesScreenFragment"
            android:label="fragment_music_languages_screen"
            tools:layout="@layout/fragment_music_languages_screen">
        </fragment>

        <fragment
            android:id="@+id/settingsScreenFragment"
            android:name="com.example.sunnzaraa.ui.drawer.SettingsScreenFragment"
            android:label="fragment_settings_screen"
            tools:layout="@layout/fragment_settings_screen">
        </fragment>

        <fragment
            android:id="@+id/termsPrivacyScreenFragment"
            android:name="com.example.sunnzaraa.ui.drawer.TermsPrivacyScreenFragment"
            android:label="fragment_terms_privacy_screen"
            tools:layout="@layout/fragment_terms_privacy_screen">
        </fragment>

        <fragment
            android:id="@+id/helpFaqScreenFragment"
            android:name="com.example.sunnzaraa.ui.drawer.HelpFaqScreenFragment"
            android:label="fragment_help_faq_screen"
            tools:layout="@layout/fragment_help_faq_screen">
        </fragment>

        <fragment
            android:id="@+id/editProfileScreenFragment"
            android:name="com.example.sunnzaraa.ui.profile.EditProfileScreenFragment"
            android:label="fragment_edit_profile_screen"
            tools:layout="@layout/fragment_edit_profile_screen">
        </fragment>

        <fragment
            android:id="@+id/favouritesScreenFragment"
            android:name="com.example.sunnzaraa.ui.favourites.FavouritesScreenFragment"
            android:label="fragment_favourites_screen"
            tools:layout="@layout/fragment_favourites_screen">
        </fragment>

        <fragment
            android:id="@+id/albumScreenFragment"
            android:name="com.example.sunnzaraa.ui.album.AlbumScreenFragment"
            android:label="fragment_album_screen"
            tools:layout="@layout/fragment_album_screen">
        </fragment>

        <fragment
            android:id="@+id/podcastScreenFragment"
            android:name="com.example.sunnzaraa.ui.podcast.PodcastScreenFragment"
            android:label="fragment_podcast_screen"
            tools:layout="@layout/fragment_podcast_screen">
        </fragment>


    </navigation>



</navigation>